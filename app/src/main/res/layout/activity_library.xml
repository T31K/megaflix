<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mf_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Top nav bar: centered tabs (logo hidden) -->
        <LinearLayout
            android:id="@+id/nav_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:paddingTop="26dp"
            android:paddingBottom="22dp">

            <TextView
                android:id="@+id/logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MEGAFLIX"
                android:textColor="@color/mf_accent"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginEnd="40dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tab_home"
                style="@style/NavTab"
                android:text="Home"
                android:textColor="@color/mf_text" />

            <TextView
                android:id="@+id/tab_shows"
                style="@style/NavTab"
                android:text="Shows"
                android:textColor="@color/mf_text_dim" />

            <TextView
                android:id="@+id/tab_movies"
                style="@style/NavTab"
                android:text="Movies"
                android:textColor="@color/mf_text_dim" />

            <TextView
                android:id="@+id/tab_search"
                style="@style/NavTab"
                android:text="Search"
                android:textColor="@color/mf_text_dim" />
        </LinearLayout>

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/rows_compose"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/mf_text_dim"
        android:text="@string/empty_library"
        android:visibility="gone" />
</FrameLayout>
